# Frontend config (Vite). Copy to .env.local and fill in.
# NOTE: every VITE_* value is bundled into the PUBLIC client JS — never put a
# secret here. For an API-keyed RPC, restrict the key by origin in the provider
# dashboard (e.g. allow only https://soteriaprivacy.app) or proxy it via the backend.

# Which cluster the UI targets. Drives explorer links and the devnet/mainnet
# badges. One switch for the whole app.
#   devnet (default) | mainnet-beta
VITE_SOLANA_CLUSTER=devnet

# RPC endpoint. Devnet default below; for mainnet use your (origin-restricted)
# provider URL, e.g. https://mainnet.helius-rpc.com/?api-key=<restricted-key>
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Backend / relayer base URL. Use http://localhost:8787 for a local backend, or
# the deployed backend URL. (Can also be overridden at runtime in the UI.)
VITE_SOTERIA_SERVER=http://localhost:8787

# On-chain program id (must match the cluster above).
VITE_SOTERIA_PROGRAM_ID=9HNLpUVFX61pX759oy1vuMMwQaQaGnK9KgMyhTrDrRGs

# Pool / group / circuit scope ids.
VITE_SOTERIA_POOL_ID=0
VITE_SOTERIA_SHIELDED_ID=5
VITE_SOTERIA_GROUP_ID=0
VITE_SOTERIA_EXTERNAL_NULLIFIER=1
