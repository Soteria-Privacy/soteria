# Paste into Dokploy → your Compose app → Environment. Never commit real values.

# --- database (internal to the stack) ---
POSTGRES_PASSWORD=change-me-long-random

# --- backend / relayer ---
# Dedicated mainnet RPC (the public endpoint rate-limits and 403s).
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<server-key>
SOTERIA_PROGRAM_ID=9HNLpUVFX61pX759oy1vuMMwQaQaGnK9KgMyhTrDrRGs
# base58 secret keys of FUNDED mainnet keypairs — they sign and pay fees.
RELAYER_SECRET_KEY=
AUTHORITY_SECRET_KEY=
# >= 16 chars, gates admin routes:  openssl rand -hex 32
ADMIN_API_KEY=
CORS_ORIGINS=https://soteriaprivacy.app
LOG_IP=false
TRUST_PROXY=false
POOL_MIN_ANONYMITY_SET=1

# --- frontend (build-time, public in the JS bundle) ---
VITE_SOLANA_CLUSTER=mainnet-beta
# Separate key restricted by origin to https://soteriaprivacy.app
VITE_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=<origin-restricted-key>
VITE_SOTERIA_SERVER=https://api.soteriaprivacy.app
VITE_SOTERIA_POOL_ID=0
VITE_SOTERIA_SHIELDED_ID=5
VITE_SOTERIA_GROUP_ID=0
VITE_SOTERIA_EXTERNAL_NULLIFIER=1
